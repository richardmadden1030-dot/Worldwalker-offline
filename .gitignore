# PyInstaller build output (regenerated by `py -m PyInstaller WorldwalkerRPG.spec`)
/build/
/dist/
/build-v*/
/dist-v*/
/release/
/release-final/
/release-v*/
/output/
/.test-*/
/.playwright-cli/

# Shipped release archives — attached to GitHub Releases instead of committed
*.zip

# Godot per-project export output and editor cache (regenerated by the
# documented `godot --headless --export-release "Web" build/index.html` step)
godot/*/build/
godot/*/.godot/

# Godot web export output copied into the served frontend — regenerated from
# godot/*/build/ via the documented copy step, not hand-edited
frontend/godot/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Runtime state written by the test suite (autosaves, etc.) — not source
tests/.runtime*/

# OS cruft
.DS_Store
Thumbs.db
